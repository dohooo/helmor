# Build context trimming for cloud/Dockerfile (context = repo root).
# Heavy/derived trees are rebuilt inside the image, so keep them out of the
# upload to keep `docker build` fast and the layer cache stable.

.git
**/node_modules
**/.bundle-cache

# Rust build output (the image rebuilds release from source).
src-tauri/target

# Frontend + sidecar build output (regenerated by the frontend / sidecar stages).
dist
sidecar/dist

# Desktop-only / local artifacts that never belong in the serve image.
**/*.log
.augment
.agent-contexts
playwright-report
test-results
storybook-static
