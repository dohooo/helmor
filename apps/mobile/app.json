{
	"expo": {
		"name": "Helmor",
		"slug": "helmor-mobile",
		"scheme": "helmor",
		"version": "0.1.0",
		"orientation": "portrait",
		"platforms": ["ios"],
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "ai.helmor.mobile",
			"supportsTablet": false,
			"infoPlist": {
				"NSCameraUsageDescription": "Allow Helmor to scan desktop pairing QR codes.",
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Helmor to scan desktop pairing QR codes."
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
